# Strata launcher settings - copy this file to `.env` and fill it in.
#
# BEFORE filling this in: read README.md in this folder.
# Its "For AI assistants" section has the pre-flight check (is Strata installed
# in WSL?), the interview guide, and the meaning of every key with valid values.
#
# Never commit your filled-in .env: it holds your API key.

# ---- required (no defaults) ----
API_KEY=
MODEL=

# ---- everything below has a working default; uncomment to override (see README.md) ----
#STRATA_DIR=/home/you/Strata
#WSL_DISTRO=Ubuntu
#PORT=8080
#HOST=127.0.0.1
#GPU_IDS=0
#USE_ESP=0
#STRATA_PF_FUSED=1
#FIT_MAX_TOKENS=1
#OPEN_BROWSER=1
#TIMEOUT_MINUTES=20
#RESIDENT_TOTAL_GIB=76
#EXTRA_URLS=

# advanced: explicit config file name (default: strata-<MODEL>.json)
#CONFIG_NAME=